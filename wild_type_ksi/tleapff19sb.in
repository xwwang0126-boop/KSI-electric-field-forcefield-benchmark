source /apps/amber20/dat/leap/cmd/leaprc.protein.ff19SB
source /apps/amber20/dat/leap/cmd/leaprc.water.opc
source /apps/amber20/dat/leap/cmd/leaprc.gaff
MOL = loadmol2 19nt.mol2
loadamberparams 19nt.frcmod
check MOL
p = loadpdb 5kp4leap.pdb
charge p
solvateoct p OPCBOX 16.0
addions p Na+ 0
savepdb p 5kp4leap.pdb
saveamberparm p p.top p.crd
quit

