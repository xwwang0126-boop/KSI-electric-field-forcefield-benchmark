source /apps/amber20/dat/leap/cmd/leaprc.protein.ff15ipq
source /apps/amber20/dat/leap/cmd/leaprc.water.tip3p
source /apps/amber20/dat/leap/cmd/leaprc.gaff
6VW = loadmol2 19nt.mol2
loadamberparams 19nt.frcmod
check 6VW
p = loadpdb 5kp4leap.pdb
charge p
solvateoct p TIP3PBOX 12.0
addions p Na+ 0
savepdb p 5kp4leap.pdb
saveamberparm p p.top p.crd
quit

